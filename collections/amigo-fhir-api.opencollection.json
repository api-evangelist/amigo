        {
          "info": {
            "name": "Update a FHIR resource",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.amigo.ai/v1/:workspace_id/fhir/resources/:resource_type/:resource_id",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "resource_type",
                "value": "",
