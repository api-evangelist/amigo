              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "General search text"
              }
            ]
          },
          "docs": "Search FHIR resources by type with standard search parameters."
        },
