{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amigo Account Auth API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get auth info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/auth/me"
          },
          "docs": "Return information about the currently authenticated API key, including expiration."
        }
      ]
    }
  ],
  "bundled": true
}