{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amigo Account Metrics API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List latest metric values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/metrics",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "source",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "service_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "run_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "session_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List the latest value for each metric in the workspace.\n\nPermissions: authenticated (any role)."
        },
        {
          "info": {
            "name": "List available metrics (builtin + custom)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/metrics/catalog",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all available metrics (builtin + custom defined on workspace).\n\nPermissions: authenticated (any role)."
        },
        {
          "info": {
            "name": "Get values for a specific metric",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/metrics/:metric_key",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "metric_key",
                "value": "",
                "type": "path",
                "description": "Metric key (lowercase alphanumeric + underscores)"
              },
              {
                "name": "source",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "service_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "run_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "session_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "date_from",
                "value": "",
                "type": "query"
              },
              {
                "name": "date_to",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get values for a specific metric with optional time range.\n\nPermissions: authenticated (any role)."
        },
        {
          "info": {
            "name": "Get time-series trend for a metric",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/metrics/:metric_key/trend",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "metric_key",
                "value": "",
                "type": "path",
                "description": "Metric key (lowercase alphanumeric + underscores)"
              },
              {
                "name": "source",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "service_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "run_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "session_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "days",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get time-series trend for a specific metric.\n\nPermissions: authenticated (any role)."
        }
      ]
    }
  ],
  "bundled": true
}