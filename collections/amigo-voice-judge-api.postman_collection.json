          "id": "b1969f57-5027-443f-8fce-40e5116de892",
          "name": "Recent voice-judge results for a service",
          "request": {
            "name": "Recent voice-judge results for a service",
            "description": {
              "content": "Returns the most recent per-call voice-judge scores for one service, ordered newest first. Produced by the Databricks `voice_judge` job (stereo audio → Gemini 2.5 Flash → 10-dimension rubric). Used by the Agent Readiness page to populate Voice Quality criterion cards.\n\n**Latency**: 500ms-2s (reads from analytics warehouse, not OLTP).\n\n**Default limit**: 20. Max 100.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                ":workspace_id",
                "services",
                ":service_id",
                "voice-judge",
                "recent"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Max rows to return (default 20, max 100)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset for pagination (default 0)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "workspace_id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "service_id",
                  "description": "(Required) Service UUID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
