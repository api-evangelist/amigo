{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amigo Account Analytics API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Usage Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/analytics/usage",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "days",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Usage summary grouped by event type and date."
        },
        {
          "info": {
            "name": "Call Stats",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/analytics/calls",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "days",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Call volume and duration statistics."
        },
        {
          "info": {
            "name": "Event Breakdown",
            "type": "http"
          },
          "http": {
            "method": "GET",
