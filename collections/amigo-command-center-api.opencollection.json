{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amigo Account Command Center API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Command Center",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Command Center",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.amigo.ai/v1/:workspace_id/command-center",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Single-pane workspace health dashboard combining voice, pipeline, data quality, and identity metrics."
        }
      ]
    }
  ],
  "bundled": true
}