            "boolean"
          ],
          "title": "Type"
        },
        "description": {
          "type": "string",
          "maxLength": 512,
          "title": "Description",
          "default": ""
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "title": "ReturnColumn",
      "description": "One column in a UDTF's output schema.\n\nUC ``RETURNS TABLE(<col1> <type1>, <col2> <type2>, ...)`` requires\ndeclaring the schema at deploy time. This list anchors that\nschema for ``function_type=udtf`` rows. ``name`` becomes the\ncolumn name in the result rows; ``type`` maps to a Databricks\nSQL type via the same ``ParameterType`` Literal we use for inputs."
    },
